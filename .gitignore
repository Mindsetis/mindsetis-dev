# ── Dependencies ─────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js / build ──────────────────────────────────────────
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# ── Testing / coverage ───────────────────────────────────────
/coverage

# ── Playwright MCP (browser-tester artifacts) ────────────────
.playwright-mcp/

# ── Env & secrets (NEVER commit) ─────────────────────────────
.env
.env.*
!.env.example

# ── Supabase (local CLI) ─────────────────────────────────────
supabase/.branches
supabase/.temp
supabase/.env

# ── Editor / OS ──────────────────────────────────────────────
.DS_Store
*.pem
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea

# ── Logs ─────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Vercel ───────────────────────────────────────────────────
.vercel

# Figma/browser test screenshot artifacts
.figma-shots-tmp/
signup-checklist-*.png

# GeoNames dump cache (scripts/seed-geo.mjs) — re-downloadable, never committed
.geonames-cache/
