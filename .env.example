# =============================================================================
# Mindsetis Community — environment variables
# -----------------------------------------------------------------------------
# Copy to `.env.local` (Next.js) for local dev:   cp .env.example .env.local
# NEVER commit real values. Only NEXT_PUBLIC_* vars reach the client bundle (§7).
# Set the same vars per environment (local dev / staging / prod).
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public base URL of the app (used for auth redirects, email links, webhooks).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# THE PRE-LAUNCH SWITCH (ROADMAP stage 1.11) — one variable, two effects. See
# lib/config/coming-soon.ts, which both readers import.
#
#   "true"   SITE CLOSED (what dev and production run). The homepage shows the waitlist
#            placeholder with its minimal header/footer, and every other route 307s back to
#            it — nothing else is reachable by URL or by navigating the site.
#
#   "false"  SITE OPEN (what you want locally, for development). The homepage shows the full
#            landing page — hero, video, platform tour, email CTA — under the normal site
#            chrome, and every route is reachable under its usual auth rules.
#
# Compared EXACTLY against the string "true": "TRUE", "1", "yes" or a stray trailing space
# all read as "false". Read once at startup, so flipping it needs `npm run dev` restarted
# locally, or a redeploy on Vercel — editing the value alone changes nothing in a running
# server.
COMING_SOON_MODE="false"

# --- Pre-launch password gate (HTTP Basic Auth, middleware.ts) ----------------
# Closes the WHOLE origin — pages, assets, Route Handlers — behind one shared password, so
# nothing is reachable before launch by visitors or crawlers. Free stand-in for Vercel's
# paid Deployment Protection add-on.
#
# ACTIVE ONLY WHEN SITE_AUTH_PASSWORD IS SET. Leave it blank/unset locally (so `npm run dev`
# is never gated) and set it in the Vercel project's env vars. Lifting the gate at launch =
# deleting that one Vercel variable; no code change, no commit.
#
# NOT app authentication: one shared password, base64-encoded (encoding, not encryption),
# meaningful only over HTTPS. The real Supabase auth runs underneath it, unchanged.
# SITE_AUTH_USER is optional — leave empty to accept ANY username and check only the password.
SITE_AUTH_USER=""
SITE_AUTH_PASSWORD=""

# -----------------------------------------------------------------------------
# Supabase  (ACTIVE — see docs/SUPABASE_SETUP.md)
# Dashboard: Project → Settings → API
# -----------------------------------------------------------------------------
# Project API URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=""
# New-format keys (preferred): Settings → API Keys.
# publishable (sb_publishable_…) — browser-safe (RLS enforces access).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# secret (sb_secret_…) — SERVER-ONLY. Bypasses RLS. NEVER expose to the client.
# Used only by lib/supabase/service.ts (Server Actions / Edge Functions).
SUPABASE_SECRET_KEY=""
# Legacy JWT keys (optional, still valid) — anon = browser-safe, service_role = server-only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Supabase CLI (migrations / local dev) -----------------------------------
# Project → Settings → General → Reference ID
SUPABASE_PROJECT_REF=""
# Project → Settings → Database → Database password (for `supabase db push`)
SUPABASE_DB_PASSWORD=""
# Personal Access Token (Account → Access Tokens) — lets the CLI push without
# browser login. Account-wide & sensitive — keep in .env.local only.
SUPABASE_ACCESS_TOKEN=""

# -----------------------------------------------------------------------------
# Stripe Connect  (later stages — 1.5 / §5.9). Leave blank for now.
# Dashboard: https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Resend — transactional email  (stage 0.9 / §6). Leave blank until wired up.
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Mindsetis <no-reply@example.com>"

# -----------------------------------------------------------------------------
# Supabase Auth — custom SMTP relay for the BUILT-IN auth emails (confirm
# signup, reset password, change email, magic link). NOT read by the Next.js
# app or by lib/email/ — these are consumed only by `supabase/config.toml`
# (`[auth.email.smtp]`, local dev / `supabase start`) and by the equivalent
# fields in Dashboard → Authentication → Emails → SMTP Settings (hosted
# project — set there directly, this .env only documents the values / feeds
# the local CLI). Using Resend as the SMTP relay; can reuse the RESEND_API_KEY
# value above as the SMTP password, or a separate key scoped to SMTP only.
# See docs/SUPABASE_SETUP.md §3a.
# -----------------------------------------------------------------------------
# DEFERRED — no custom SMTP for now (see supabase/config.toml). Auth emails use
# Supabase's default sender. Uncomment when a verified sending domain is ready.
# SUPABASE_AUTH_SMTP_PASS=""
# SUPABASE_AUTH_SMTP_SENDER_EMAIL="no-reply@example.com"

# -----------------------------------------------------------------------------
# Email queue (stage 0.9) — pg_cron -> pg_net -> Edge Function pipeline.
# -----------------------------------------------------------------------------
# NOTE: these are EDGE FUNCTION secrets, not Next.js env vars — they are never
# read by the Next.js app and must NOT go in `.env.local`. Supabase Edge
# Functions read secrets set separately via the CLI:
#   supabase secrets set RESEND_API_KEY=... RESEND_FROM_EMAIL="..." \
#     QUEUE_TRIGGER_SECRET=...
# (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are auto-injected into every Edge
# Function by the platform — do not set those via `supabase secrets set`.)
# See supabase/functions/process-email-queue/index.ts and
# supabase/migrations/20260701110100_email_queue_cron.sql for the full
# pipeline + one-time operator setup steps (deploy + secrets + the
# email_queue_settings row pointing at the deployed function URL).
#
# QUEUE_TRIGGER_SECRET — shared secret pg_cron/pg_net sends as the
# `x-queue-secret` header when invoking process-email-queue; generate a random
# value (e.g. `openssl rand -hex 32`) and set the SAME value both as the Edge
# Function secret above AND as the `trigger_secret` row in
# `email_queue_settings` (see the migration's header comment for the exact
# SQL). Listed here only so its purpose/shape is documented next to
# RESEND_*; it is not consumed by the Next.js app.
QUEUE_TRIGGER_SECRET=""

# -----------------------------------------------------------------------------
# OpenAI — embeddings + LLM for AI search  (later stage — 1.8 / §6).
# -----------------------------------------------------------------------------
OPENAI_API_KEY=""

# -----------------------------------------------------------------------------
# Google Sign-in (OAuth) — handled by SUPABASE AUTH, NOT the app.
# There are NO app env vars for Google login: the Client ID / Secret are entered
# in Supabase Dashboard → Authentication → Providers → Google. The app just calls
# supabase.auth.signInWithOAuth({ provider: 'google' }). See docs/SUPABASE_SETUP.md.
# (Deferred anyway — auth is email+password at stage 0.6.)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Google Calendar / Meet — server-side API for auto Meet links (later — 1.4 / §6).
# Separate from Google login above; these ARE app credentials. Leave blank for now.
# -----------------------------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_EMAIL=""
GOOGLE_CALENDAR_PRIVATE_KEY=""

# -----------------------------------------------------------------------------
# Upstash Redis — cache / rate-limit  (DEFERRED by request — wire later / §6).
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
